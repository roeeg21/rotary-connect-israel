# Server-only secrets. Copy this file to .env.local and fill in the values.
# Set the same secrets in your hosting environment for deployed registration.

# MongoDB
MONGODB_URI=
MONGODB_DB_NAME=rotary_connect_israel

# OpenAI-compatible API (Primary - used for search and chat)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Gemini AI (Alternative)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_SEARCH_MODEL=gemini-3.5-flash-lite

# Anthropic (Alternative)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_SEARCH_MODEL=claude-sonnet-4-6

# Resend Email Service (for OTP login)
# Get your API key at https://resend.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@rotary-connect.co.il

